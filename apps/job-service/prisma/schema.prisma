// ============================================================
// Job Management Service — Prisma Schema
// Schema: jobs (isolated from other services)
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("JOBS_DATABASE_URL")
  directUrl = env("JOBS_DIRECT_DATABASE_URL")
}

// ============================================================
// TRADE TEMPLATE SYSTEM (DB-driven, extensible without code)
// Admin adds a new trade type → job templates → tasks
// All from the admin dashboard — zero code changes needed
// ============================================================

// e.g. HVAC, Plumbing, Electrical, General, Landscaping…
model JobType {
  id          String   @id @default(uuid())
  companyId   String
  name        String // "HVAC", "Plumbing"
  slug        String // "hvac", "plumbing" — for icons/routing
  description String?
  icon        String? // lucide icon name or URL
  color       String? // hex, for UI colour coding
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates       JobTemplate[]
  customFieldDefs JobCustomFieldDef[]
  jobs            Job[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("job_types")
}

// Template per job type — e.g. "HVAC Annual Maintenance", "AC Installation"
model JobTemplate {
  id                    String   @id @default(uuid())
  companyId             String
  jobTypeId             String
  jobType               JobType  @relation(fields: [jobTypeId], references: [id])
  name                  String // "Annual AC Tune-Up"
  description           String?
  estimatedDurationMins Int      @default(60)
  version               Int      @default(1)
  isActive              Boolean  @default(true)
  requiredParts         Json? // [{inventoryItemId, name, qty}] — parts needed for this job type
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tasks JobTemplateTask[]
  jobs  Job[]

  @@index([companyId])
  @@index([jobTypeId])
  @@map("job_templates")
}

// Individual checklist tasks within a template
// Technician ticks these off on-site
model JobTemplateTask {
  id            String      @id @default(uuid())
  templateId    String
  template      JobTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  taskName      String // "Check refrigerant levels"
  description   String?
  taskOrder     Int
  isRequired    Boolean     @default(true)
  photoRequired Boolean     @default(false)
  safetyNote    String? // highlighted in red on technician app
  estimatedMins Int?
  createdAt     DateTime    @default(now())

  @@index([templateId])
  @@map("job_template_tasks")
}

// Dynamic custom field DEFINITIONS per job type
// e.g. HVAC → "refrigerant_type" (select), "tonnage" (number), "filter_size" (text)
// e.g. Electrical → "panel_amperage" (number), "circuit_count" (number)
model JobCustomFieldDef {
  id         String          @id @default(uuid())
  companyId  String
  jobTypeId  String
  jobType    JobType         @relation(fields: [jobTypeId], references: [id])
  fieldKey   String // machine-readable key: "refrigerant_type"
  label      String // human label: "Refrigerant Type"
  fieldType  CustomFieldType
  options    Json? // for SELECT type: ["R-410A", "R-22", "R-32"]
  isRequired Boolean         @default(false)
  helpText   String?
  sortOrder  Int             @default(0)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())

  values JobCustomFieldValue[]

  @@unique([jobTypeId, fieldKey])
  @@index([jobTypeId])
  @@map("job_custom_field_defs")
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  DATE
  TEXTAREA
}

// Actual values stored per job — flexible JSONB
model JobCustomFieldValue {
  id         String            @id @default(uuid())
  jobId      String
  job        Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fieldDefId String
  fieldDef   JobCustomFieldDef @relation(fields: [fieldDefId], references: [id])
  value      Json // stores any type — text, number, array, boolean
  updatedAt  DateTime          @updatedAt

  @@unique([jobId, fieldDefId])
  @@index([jobId])
  @@map("job_custom_field_values")
}

// ============================================================
// PRICE BOOK
// ============================================================

model PriceBookItem {
  id          String        @id @default(uuid())
  companyId   String
  category    PriceCategory
  code        String? // internal part/service code
  name        String
  description String?
  unit        String        @default("each") // each, hour, sqft, lbs
  unitPrice   Decimal       @db.Decimal(10, 2)
  taxable     Boolean       @default(true)
  isActive    Boolean       @default(true)
  jobTypeId   String? // optional: restrict to a trade type
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lineItems WorkOrderLineItem[]

  @@index([companyId])
  @@index([companyId, category])
  @@map("price_book_items")
}

enum PriceCategory {
  LABOUR
  PART
  MATERIAL
  EQUIPMENT_RENTAL
  SUBCONTRACTOR
  OTHER
}

// ============================================================
// JOBS
// ============================================================

model Job {
  id               String   @id @default(uuid())
  companyId        String
  jobNumber        String // human-readable: "JOB-2024-0001"
  customerId       String // FK to crm.customers (cross-service ref)
  customerName     String // denormalised for display without join
  customerPhone    String?
  customerEmail    String?
  serviceAddress   String
  serviceCity      String?
  serviceState     String?
  serviceZip       String?
  serviceLatitude  Decimal? @db.Decimal(10, 7)
  serviceLongitude Decimal? @db.Decimal(10, 7)

  jobTypeId   String?
  jobType     JobType?     @relation(fields: [jobTypeId], references: [id])
  templateId  String?
  template    JobTemplate? @relation(fields: [templateId], references: [id])
  projectId   String? // FK to crm.projects (cross-service ref)
  houseId     String? // FK to crm.houses (cross-service ref) — deprecated, see componentId
  componentId String? // FK to crm.project_components (cross-service ref) — replaces houseId
  equipmentId String? // FK to crm.equipment (cross-service ref) — optional, which unit was serviced

  title       String
  description String?
  status      JobStatus   @default(PENDING)
  priority    JobPriority @default(NORMAL)

  // Scheduling refs (set by scheduling-service, stored here for query convenience)
  assignedToId   String? // Auth0 user ID of the LEAD technician
  assignedToName String?
  /// Every crew member's user id, lead included. Denormalised so the technician
  /// app's "my jobs" query stays a single job-service query instead of a
  /// cross-service join on its hottest path. Maintained by scheduling-service in
  /// the same transaction as the assignment change.
  crewUserIds       String[] @default([])
  /// Optional target crew size. Guidance for smart assign and the "2 of 3"
  /// counter, never a rule — a dispatcher may confirm any size.
  requiredTechCount Int?
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?

  estimatedDurationMins Int?
  travelDistanceKm      Decimal? @db.Decimal(8, 2)

  // Estimated job value, used by dashboards and forecasts before an invoice
  // exists. Settable on create (e.g. from quote total or a template estimate)
  // and updated by finance-service when a quote is converted. The billed
  // amount remains authoritative on the Invoice record.
  estimatedValue Decimal? @db.Decimal(10, 2)
  currency       String   @default("USD")

  // Finance refs (set by finance-service)
  quoteId   String?
  invoiceId String?

  // Agreement ref (set when auto-created from a crm.service_agreements row)
  agreementId    String?
  isAgreementJob Boolean @default(false)

  notes         String?
  internalNotes String?
  tags          String[]

  cancellationReason String?
  hasPartShortage    Boolean @default(false)
  partShortageNote   String?

  // Denormalized "whose move is it" for the open reschedule request, if any.
  // Written in the same transaction as the request so it cannot drift. Exists so
  // every job list can render a status badge with no join and no extra query —
  // see docs/superpowers/specs/2026-08-05-job-rescheduling-design.md.
  rescheduleState RescheduleState?

  createdByUserId String // Auth0 user ID
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  workOrders         WorkOrder[]
  customFieldValues  JobCustomFieldValue[]
  statusHistory      JobStatusHistory[]
  photos             JobPhoto[]
  crewEvents         JobCrewEvent[]
  rescheduleRequests RescheduleRequest[]

  @@unique([companyId, jobNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, assignedToId])
  @@index([companyId, scheduledStart])
  @@index([customerId])
  @@index([agreementId])
  @@index([companyId, projectId])
  @@index([houseId])
  @@index([componentId])
  @@index([equipmentId])
  @@index([companyId, rescheduleState])
  @@map("jobs")
}

enum JobStatus {
  PENDING
  SCHEDULED
  EN_ROUTE
  ON_SITE
  COMPLETED
  INVOICED
  PAID
  CANCELLED
  ON_HOLD
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

// Audit trail of every job status change
model JobStatusHistory {
  id            String     @id @default(uuid())
  jobId         String
  job           Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromStatus    JobStatus?
  toStatus      JobStatus
  changedById   String // Auth0 user ID
  changedByName String
  note          String?
  createdAt     DateTime   @default(now())

  @@index([jobId])
  @@map("job_status_history")
}

// Job photos (uploaded by technician on-site)
model JobPhoto {
  id           String    @id @default(uuid())
  jobId        String
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workOrderId  String?
  s3Key        String // e.g. "photos/company-id/job-id/before-001.jpg"
  caption      String?
  photoType    PhotoType @default(GENERAL)
  uploadedById String // Auth0 user ID
  createdAt    DateTime  @default(now())

  @@index([jobId])
  @@map("job_photos")
}

enum PhotoType {
  BEFORE
  AFTER
  GENERAL
  EQUIPMENT
  ISSUE
}

// ============================================================
// WORK ORDERS (one per visit / per technician)
// The technician-facing document with tasks + parts used
// ============================================================

model WorkOrder {
  id              String          @id @default(uuid())
  companyId       String
  jobId           String
  job             Job             @relation(fields: [jobId], references: [id])
  workOrderNumber String // "WO-2024-0001"
  technicianId    String // Auth0 user ID
  technicianName  String
  status          WorkOrderStatus @default(PENDING)
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  checkinAt       DateTime?
  checkoutAt      DateTime?
  signatureUrl    String? // customer signature S3 key
  technicianNotes String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  lineItems       WorkOrderLineItem[]
  taskCompletions WorkOrderTaskCompletion[]

  @@unique([companyId, workOrderNumber])
  @@index([companyId])
  @@index([jobId])
  @@index([technicianId])
  @@map("work_orders")
}

enum WorkOrderStatus {
  PENDING
  EN_ROUTE
  ON_SITE
  COMPLETED
  CANCELLED
}

// Tracks completion of each checklist task per work order
model WorkOrderTaskCompletion {
  id             String    @id @default(uuid())
  workOrderId    String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  templateTaskId String? // null for ad-hoc tasks added by admins
  isAdHoc        Boolean   @default(false)
  taskName       String // denormalised for record-keeping
  isRequired     Boolean   @default(false)
  isCompleted    Boolean   @default(false)
  photoUrl       String?
  notes          String?
  completedAt    DateTime?

  @@index([workOrderId])
  @@map("work_order_task_completions")
}

// Parts and labour used in a work order (feeds into invoice)
model WorkOrderLineItem {
  id              String         @id @default(uuid())
  workOrderId     String
  workOrder       WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  priceBookItemId String?
  priceBookItem   PriceBookItem? @relation(fields: [priceBookItemId], references: [id])
  description     String
  category        PriceCategory  @default(PART)
  quantity        Decimal        @default(1) @db.Decimal(8, 2)
  unitPrice       Decimal        @db.Decimal(10, 2)
  taxable         Boolean        @default(true)
  // computed: quantity × unitPrice (stored for invoice snapshot)
  lineTotal       Decimal        @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())

  @@index([workOrderId])
  @@map("work_order_line_items")
}

// ============================================================
// RESCHEDULING — two-way negotiation over a job's appointment
//
// Either side may open a request, proposing 1–3 candidate slots or asking
// openly for the other's availability. Counters append a new row (marking the
// previous one SUPERSEDED) so the whole negotiation survives. Staff always
// confirm the final calendar write.
//
// Design: docs/superpowers/specs/2026-08-05-job-rescheduling-design.md
// ============================================================

model RescheduleRequest {
  id        String @id @default(uuid())
  companyId String
  jobId     String
  job       Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  openedBy       RescheduleActor
  openedByUserId String?
  openedByName   String?
  mode           RescheduleMode
  reasonCode     RescheduleReason
  reason         String? // free text, shown verbatim to the other side

  slots RescheduleSlot[] // 1–3 when PROPOSE_SLOTS, empty when OPEN_ASK

  status          RescheduleStatus @default(AWAITING_RESPONSE)
  pickedSlotId    String?
  responseNote    String?
  respondedAt     DateTime?
  respondedByName String?
  appliedAt       DateTime?
  nudgedAt        DateTime? // set by the staleness sweep; null = not yet nudged

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, jobId])
  @@index([companyId, status])
  @@map("reschedule_requests")
}

// A child table rather than a JSON column: pickedSlotId ultimately writes to a
// customer's calendar, so "the applied slot is one we actually offered" is worth
// having the database guarantee instead of trusting the service to have checked.
model RescheduleSlot {
  id        String            @id @default(uuid())
  requestId String
  request   RescheduleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  window    String? // 'morning' | 'afternoon' | 'evening' — display label

  @@index([requestId])
  @@map("reschedule_slots")
}

enum RescheduleActor {
  ADMIN
  CUSTOMER
}

enum RescheduleMode {
  PROPOSE_SLOTS
  OPEN_ASK
}

enum RescheduleStatus {
  AWAITING_RESPONSE
  SLOT_PICKED
  DECLINED
  SUPERSEDED
  APPLIED
  CANCELLED
}

enum RescheduleState {
  AWAITING_CUSTOMER
  AWAITING_ADMIN
  READY_TO_APPLY
}

enum RescheduleReason {
  PARTS_DELAY
  TECH_UNAVAILABLE
  WEATHER
  EMERGENCY_BUMP
  CAPACITY
  CUSTOMER_UNAVAILABLE
  ACCESS_ISSUE
  OTHER
}


/// Audit trail for crew changes: who was added, removed, handed the lead, or
/// checked out, and who did it.
///
/// Cannot reuse JobStatusHistory, whose toStatus is a required JobStatus enum —
/// a handover is not a status change, and forcing it in would corrupt that
/// table's meaning.
model JobCrewEvent {
  id             String           @id @default(uuid())
  companyId      String
  jobId          String
  job            Job              @relation(fields: [jobId], references: [id])
  event          JobCrewEventType
  technicianId   String
  technicianName String
  /// Set only for LEAD_CHANGED: who held the lead before this event.
  previousLeadId String?
  actorId        String
  actorName      String
  reason         String?
  createdAt      DateTime         @default(now())

  @@index([companyId, jobId])
  @@map("job_crew_events")
}

enum JobCrewEventType {
  ADDED
  REMOVED
  LEAD_CHANGED
  CHECKED_OUT
}
