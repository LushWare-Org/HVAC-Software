generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("INVENTORY_DATABASE_URL")
}

enum ItemCategory {
  PART
  MATERIAL
  TOOL
  CONSUMABLE
}

enum LocationType {
  WAREHOUSE
  VAN
}

enum MovementType {
  INTAKE
  TRANSFER
  CONSUME
  ADJUST
  RETURN
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model InventoryItem {
  id              String       @id @default(uuid())
  companyId       String
  priceBookItemId String?
  sku             String
  name            String
  description     String?
  category        ItemCategory
  unit            String       @default("each")
  reorderPoint    Int          @default(5)
  reorderQty      Int          @default(10)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  stockLevels    StockLevel[]
  stockMovements StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([companyId, category])
  @@index([priceBookItemId])
  @@map("inventory_items")
}

model StockLocation {
  id           String       @id @default(uuid())
  companyId    String
  type         LocationType
  name         String
  technicianId String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  stockLevels   StockLevel[]
  movementsFrom StockMovement[] @relation("FromLocation")
  movementsTo   StockMovement[] @relation("ToLocation")

  @@unique([companyId, technicianId])
  @@index([companyId])
  @@index([companyId, type])
  @@map("stock_locations")
}

model StockLevel {
  id              String        @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  locationId      String
  location        StockLocation @relation(fields: [locationId], references: [id])
  quantity        Decimal       @default(0) @db.Decimal(10, 2)
  reservedQty     Decimal       @default(0) @db.Decimal(10, 2)
  updatedAt       DateTime      @updatedAt

  @@unique([inventoryItemId, locationId])
  @@index([locationId])
  @@index([inventoryItemId])
  @@map("stock_levels")
}

model StockMovement {
  id              String         @id @default(uuid())
  companyId       String
  inventoryItemId String
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  fromLocationId  String?
  fromLocation    StockLocation? @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId    String?
  toLocation      StockLocation? @relation("ToLocation", fields: [toLocationId], references: [id])
  quantity        Decimal        @db.Decimal(10, 2)
  movementType    MovementType
  referenceId     String?
  referenceType   String?
  notes           String?
  performedBy     String
  performedByName String?
  createdAt       DateTime       @default(now())

  @@index([companyId])
  @@index([inventoryItemId])
  @@index([companyId, movementType])
  @@index([companyId, createdAt])
  @@map("stock_movements")
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  companyId     String
  poNumber      String
  supplierName  String
  status        PurchaseOrderStatus @default(DRAFT)
  items         Json
  totalCost     Decimal             @default(0) @db.Decimal(10, 2)
  notes         String?
  orderedAt     DateTime?
  receivedAt    DateTime?
  createdBy     String
  createdByName String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([companyId, poNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@map("purchase_orders")
}
