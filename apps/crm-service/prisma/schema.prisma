// ============================================================
// CRM Service â€” Prisma Schema
// Schema: crm (isolated from other services)
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("CRM_DATABASE_URL")      // pgbouncer (runtime)
  directUrl = env("CRM_DIRECT_DATABASE_URL") // session mode (migrations / prisma studio)
}

// ---- Companies (tenants) ----
model Company {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String   @default("US")
  logoUrl     String?
  website     String?
  currency    String   @default("USD")
  timezone    String   @default("America/New_York")
  features    Json     @default("{}")
  isActive    Boolean  @default(true)
  automaticFollowupEnabled Boolean @default(true)
  trialEndsAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customers   Customer[]
  contacts    Contact[]
  leads       Lead[]
  agreements  ServiceAgreement[]
  bookings    Booking[]
  users       CompanyUser[]

  @@map("companies")
}

// ---- Company Users (staff members with roles) ----
model CompanyUser {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  auth0UserId  String?
  name         String
  email        String
  phone        String?
  passwordHash      String?
  mustResetPassword Boolean  @default(false)        // Set true when admin provisions account with temp password
  role              String   @default("technician") // super_admin, company_admin, office_manager, dispatcher, technician
  isActive          Boolean  @default(true)
  approvalStatus    String   @default("APPROVED")   // APPROVED | PENDING | REJECTED (PENDING for self-registered technicians)
  approvalNote      String?                          // rejection reason or admin notes
  skills         String[] @default([])            // technician skills submitted at signup
  latitude       Float?                           // location submitted at signup
  longitude      Float?
  avatarUrl      String?                          // public object-storage URL (MinIO dev / GCS prod); shown to customers in en-route emails
  lastLoginAt    DateTime?

  // Push notifications (FCM / APNs / Expo). Set by the technician app at login
  // and on token refresh. Cleared on logout. comms-service.PushService reads
  // pushToken via this user record when sending PUSH notifications.
  pushToken           String?
  pushPlatform        String?  // "ios" | "android" | "web" | "expo"
  pushTokenUpdatedAt  DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, email])
  @@index([companyId])
  @@index([companyId, role])
  @@index([pushToken])
  @@map("company_users")
}

// ---- User Login Events (audit log) ----
model UserLoginEvent {
  id            String   @id @default(uuid())
  companyId     String
  userId        String
  userEmail     String
  ipAddress     String?
  userAgent     String?
  loggedInAt    DateTime @default(now())

  @@index([companyId, userId])
  @@index([companyId, loggedInAt])
  @@map("user_login_events")
}

// ---- Customers (business accounts or residential) ----
model Customer {
  id          String       @id @default(uuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  type        CustomerType @default(RESIDENTIAL)
  firstName   String
  lastName    String
  email       String?
  phone       String?
  mobile      String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  notes       String?
  source      String?      // how they found us
  tags        String[]     // flexible tagging
  isActive    Boolean      @default(true)
  automaticFollowupEnabled Boolean @default(true)
  engagementStatus CustomerEngagementStatus @default(ACTIVE)
  auth0UserId   String?      // when customer has portal access
  importBatchId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  contacts    Contact[]
  leads       Lead[]
  agreements  ServiceAgreement[]
  bookings    Booking[]
  reviews     Review[]
  addresses   Address[]
  equipment   Equipment[]
  upsellRecommendations UpsellRecommendation[]
  retentionRecommendations RetentionRecommendation[]
  iotConnections CustomerIotConnection[]

  @@index([companyId])
  @@index([companyId, email])
  @@index([companyId, lastName])
  @@map("customers")
}

enum CustomerType {
  RESIDENTIAL
  COMMERCIAL
}

// ---- Contacts (multiple contacts per customer account) ----
model Contact {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String?
  phone      String?
  role       String?  // e.g. "Property Manager", "Owner"
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([customerId])
  @@map("contacts")
}

// ---- Leads (pre-customer pipeline) ----
model Lead {
  id           String     @id @default(uuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id])
  firstName    String
  lastName     String
  email        String?
  phone        String?
  source          String?    // google, referral, website, META_LEADGEN, etc.
  serviceInterest  String?    // what service they're interested in
  whatsappNo      String?    // WhatsApp / mobile number
  type            String?    // customer type / category
  status           LeadStatus @default(NEW)
  estimatedValue Decimal? @db.Decimal(10, 2)
  notes        String?
  assignedToId String?    // Auth0 user ID of assigned staff
  convertedAt  DateTime?  // when lead became customer
  leadgenId    String?    // Meta Lead Ads leadgen ID (unique per lead)
  adName       String?    // Meta ad name at capture time
  formId       String?    // Meta lead gen form ID
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  addresses    Address[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([leadgenId])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum CustomerEngagementStatus {
  ACTIVE
  QUOTE_SENT
  INVOICE_SENT
  JOB_BOOKED
  COMPLETED
  INACTIVE
}

// ---- Service Agreements / Maintenance Contracts ----
model ServiceAgreement {
  id           String          @id @default(uuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  customerId   String
  customer     Customer        @relation(fields: [customerId], references: [id])
  name         String
  description  String?
  status       AgreementStatus @default(DRAFT)
  startDate    DateTime
  endDate      DateTime?
  value        Decimal?        @db.Decimal(10, 2)
  billingCycle String?         // UPFRONT, MONTHLY, QUARTERLY, ANNUAL
  autoRenew    Boolean         @default(false)
  signedAt     DateTime?
  signedByName String?
  documentUrl  String?         // S3 key for signed PDF

  // Pricing
  billingAmount   Decimal?  @db.Decimal(10, 2) // per-billing-period amount
  nextBillingDate DateTime?

  // Service schedule
  serviceType         String? // e.g. "AC Maintenance", "Filter Replacement"
  serviceInterval     String? // MONTHLY, BI_MONTHLY, QUARTERLY, BI_ANNUAL, ANNUAL, CUSTOM
  serviceIntervalDays Int? // for CUSTOM interval
  visitsIncluded      Int? // null = unlimited
  visitsUsed          Int       @default(0)
  lastServiceDate     DateTime?
  nextServiceDate     DateTime?

  // Auto job creation
  autoCreateJobs Boolean @default(true)
  leadDays       Int     @default(7)
  jobTemplateId  String?

  // Projects link — agreement-generated jobs inherit this
  projectId String?

  // Customer confirmation & renewal
  customerConfirmedAt DateTime?
  confirmToken        String?   @unique // one-time token for email confirm link
  renewalReminderSent Boolean   @default(false)
  renewedFromId       String? // previous agreement this one renews

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  amendments AgreementAmendment[]

  @@index([companyId])
  @@index([customerId])
  @@index([companyId, status])
  @@index([companyId, nextServiceDate])
  @@map("service_agreements")
}

model AgreementAmendment {
  id                  String           @id @default(uuid())
  agreementId         String
  agreement           ServiceAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  changedFields       Json // { field: { from, to } } snapshot
  changedBy           String // user id
  changedByName       String?
  customerNotifiedAt  DateTime?
  customerConfirmedAt DateTime?
  createdAt           DateTime         @default(now())

  @@index([agreementId])
  @@map("agreement_amendments")
}

enum AgreementStatus {
  DRAFT
  SENT
  ACTIVE
  PENDING_RENEWAL
  RENEWED
  EXPIRED
  CANCELLED
}

// ---- Bookings (online booking portal requests) ----
model Booking {
  id             String        @id @default(uuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  // For anonymous bookings (not yet a customer)
  guestName      String?
  guestEmail     String?
  guestPhone     String?
  serviceType    String
  description    String?
  preferredDate  DateTime
  alternateDate  DateTime?
  status         BookingStatus @default(PENDING)
  jobId          String?       // set when converted to a job
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@map("bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CONVERTED
  CANCELLED
}

// ---- Reviews / Reputation Management ----
// A Review is authored by a customer and targets either a specific job
// (type = JOB, jobId + technicianId set) or the company as a whole
// (type = COMPANY, no jobId). Denormalized names avoid cross-service joins
// when listing reviews.
model Review {
  id             String      @id @default(uuid())
  companyId      String
  type           ReviewType  @default(JOB)

  // Author (customer)
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  customerName   String?

  // Target: a specific job + its assigned technician
  jobId          String?
  technicianId   String?
  technicianName String?

  rating         Int         // 1-5
  comment        String?
  platform       String      @default("internal") // google, internal
  isPublished    Boolean     @default(true)       // customer-submitted reviews are live by default
  respondedAt    DateTime?
  response       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([companyId])
  @@index([customerId])
  @@index([technicianId])
  @@index([companyId, type])
  @@index([jobId])
  @@map("reviews")
}

enum ReviewType {
  JOB     // Review of a specific completed job / the assigned technician
  COMPANY // General review of the company / business
}

// ---- Addresses (multiple per customer or lead) ----
model Address {
  id          String      @id @default(uuid())
  companyId   String
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String      @default("Site")  // Site, Billing, Shipping
  line1       String
  line2       String?
  city        String?
  state       String?
  postcode    String?
  isPrimary   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId])
  @@index([leadId])
  @@map("addresses")
}

// ---- Equipment (installed at customer sites) ----
model Equipment {
  id          String    @id @default(uuid())
  companyId   String
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String    @default("Boiler")  // Boiler, AC Unit, Heat Pump, etc.
  brand       String?
  model       String?
  serialNo    String?
  installDate DateTime?
  warrantyEnd DateTime?
  notes         String?
  importBatchId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  consumables   EquipmentConsumable[]
  manualUrl     String?   @map("manual_url")

  @@index([customerId])
  @@map("equipment")
}

model EquipmentConsumable {
  id             String    @id @default(uuid())
  companyId      String
  equipmentId    String
  equipment      Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  kind           String    @default("FILTER") // FILTER | UV_BULB | PAD | OTHER
  partNumber     String?                      // "X6673"
  description    String?                      // "Healthy Climate HCF20-11"
  sizeSpec       String?                      // "20x25x5"
  rating         String?                      // "MERV 11"
  intervalDays   Int       @default(90)
  lastReplacedAt DateTime?
  purchaseUrl    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([equipmentId])
  @@index([companyId])
  @@map("equipment_consumables")
}

model ContractorPost {
  id           String    @id @default(uuid())
  companyId    String
  type         String    @default("TIP")  // TIP | VIDEO | OFFER
  title        String
  body         String?
  videoUrl     String?
  heroImageUrl String?
  isPinned     Boolean   @default(false)
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId, isPublished])
  @@map("contractor_posts")
}

model CompanyAnnouncement {
  id          String    @id @default(uuid())
  companyId   String
  title       String
  body        String?
  linkUrl     String?
  linkLabel   String?
  accentColor String    @default("#1a73e8")
  isActive    Boolean   @default(true)
  activeFrom  DateTime?
  activeTo    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, isActive])
  @@map("company_announcements")
}

model FollowupAttempt {
  id               String   @id
  companyId        String   @map("company_id")
  entityType       String   @map("entity_type")
  entityId         String   @map("entity_id")
  customerId       String?  @map("customer_id")
  leadId           String?  @map("lead_id")
  action           String
  status           String
  churnProbability Float?   @map("churn_probability")
  queueJobId       String?  @map("queue_job_id")
  reason           String?
  errorMessage     String?  @map("error_message")
  metadata         Json?
  triggeredAt      DateTime @default(now()) @map("triggered_at")
  queuedAt         DateTime? @map("queued_at")
  failedAt         DateTime? @map("failed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([companyId, entityType, entityId, triggeredAt])
  @@index([companyId, status, triggeredAt])
  @@map("followup_attempts")
}

// Feedback log for the rule-based + LLM upsell decision engine (see
// apps/crm-service/src/upsell/). recommendedOffer stores the rule-decided
// UpsellCategory (kept for backward compatibility with the field name the
// dashboard already reads); llmOffer/bundle/channel/message/reasonCode/reason
// hold the LLM-refined recommendation. The outcome columns are filled in
// later as the offer plays out and become the training dataset for a future
// ML-backed replacement of the rule engine — mirrors RetentionRecommendation.
model UpsellRecommendation {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  customerId       String   @map("customer_id")
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recommendedOffer String   @map("recommended_offer") // UpsellCategory decided by the rule engine
  confidence       Float
  status           String   @default("pending")
  allScores        Json?    @map("all_scores") // deprecated: legacy ML score distribution, no longer populated
  ruleOffer        String?  @map("rule_offer") // matched rule id, e.g. "equipment.aging"
  modelOffer       String?  @map("model_offer") // "llm" | "rule_engine" — which layer produced the final offer
  triggerSource    String?  @map("trigger_source")
  priorityScore    Float?   @map("priority_score")
  inputPayload     Json?    @map("input_payload")

  ruleResult        Json?  @map("rule_result")
  llmRecommendation Json?  @map("llm_recommendation")
  validationResult  Json?  @map("validation_result")

  llmOffer   String? @map("llm_offer") // specific product/service text from the LLM (or null when no LLM offer passed validation)
  bundle     String? @map("bundle")
  channel    String? @map("channel")
  message    String? @map("message")
  reasonCode String? @map("reason_code")
  reason     String? @map("reason")

  managerOverride  Json?     @map("manager_override")
  offerAccepted    Boolean?  @map("offer_accepted")
  offerRejected    Boolean?  @map("offer_rejected")
  upsellConversion Boolean?  @map("upsell_conversion")
  revenueGenerated Decimal?  @map("revenue_generated") @db.Decimal(10, 2)
  respondedAt      DateTime? @map("responded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId, customerId, createdAt])
  @@index([companyId, status, priorityScore])
  @@map("upsell_recommendations")
}

// Feedback log for the rule-based + LLM retention decision engine (see
// apps/crm-service/src/retention/). One row per generated recommendation;
// the outcome columns are filled in later as the offer plays out and become
// the training dataset for a future ML-backed replacement of the rule engine.
model RetentionRecommendation {
  id                String   @id @default(uuid())
  companyId         String   @map("company_id")
  customerId        String   @map("customer_id")
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  ruleResult        Json     @map("rule_result")
  llmRecommendation Json?    @map("llm_recommendation")
  validationResult  Json     @map("validation_result")

  finalAction       String   @map("final_action")
  finalOffer        Json     @map("final_offer")
  finalPriority     String   @map("final_priority")
  finalChannel      String?  @map("final_channel")
  finalMessage      String?  @map("final_message")
  reason            String
  confidence        Float?
  status            String   @default("generated") // generated | actioned | superseded

  managerOverride     Json?     @map("manager_override")
  customerAccepted    Boolean?  @map("customer_accepted")
  customerDeclined    Boolean?  @map("customer_declined")
  retentionSuccess    Boolean?  @map("retention_success")
  revenueGenerated    Decimal?  @map("revenue_generated") @db.Decimal(10, 2)
  respondedAt         DateTime? @map("responded_at")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([companyId, customerId, createdAt])
  @@index([companyId, status, finalAction])
  @@map("retention_recommendations")
}

// ---- Data Import ----
enum ImportStatus {
  VALIDATING
  READY
  IMPORTING
  DONE
  FAILED
  ROLLED_BACK
}

model ImportBatch {
  id          String       @id @default(uuid())
  companyId   String
  source      String       // 'jobber' | 'hcp' | 'generic' | 'equipment'
  status      ImportStatus @default(VALIDATING)
  totalRows   Int          @default(0)
  imported    Int          @default(0)
  skipped     Int          @default(0)
  failed      Int          @default(0)
  createdBy   String
  rawData     Json?
  columnMap   Json?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  errors      ImportError[]

  @@index([companyId])
  @@map("import_batches")
}

model ImportError {
  id         Int         @id @default(autoincrement())
  batchId    String
  batch      ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber  Int
  entityType String
  rawData    Json
  error      String
  createdAt  DateTime    @default(now())

  @@index([batchId])
  @@map("import_errors")
}

// ---- IoT Device Connections ----
model CustomerIotConnection {
  id             String   @id @default(uuid())
  companyId      String
  customerId     String
  provider       String   // "honeywell" | "nest"
  accessToken    String   @db.Text
  refreshToken   String   @db.Text
  tokenExpiresAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  devices  CustomerIotDevice[]

  @@unique([customerId, provider])
  @@index([companyId])
  @@map("customer_iot_connections")
}

model CustomerIotDevice {
  id           String   @id @default(uuid())
  connectionId String
  deviceId     String
  locationId   String?
  name         String
  type         String   @default("thermostat")
  lastSnapshot Json?
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connection CustomerIotConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  histories  IotDeviceHistory[]

  @@unique([connectionId, deviceId])
  @@index([connectionId])
  @@map("customer_iot_devices")
}

// Time-series history of device snapshots — unlocks trending, performance detection,
// and predictive maintenance. Written on every sync.
model IotDeviceHistory {
  id         String   @id @default(uuid())
  deviceId   String
  companyId  String
  customerId String
  snapshot   Json
  recordedAt DateTime @default(now())

  device CustomerIotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt])
  @@index([companyId, recordedAt])
  @@index([customerId, recordedAt])
  @@map("iot_device_history")
}


// ─── Projects module (spec: docs/superpowers/specs/2026-07-04-projects-module-design.md) ──

model Project {
  id                String    @id @default(uuid())
  companyId         String
  customerId        String
  name              String
  description       String?
  category          String?             // free text, reporting only
  status            String    @default("PLANNING") // PLANNING | ACTIVE | ON_HOLD | COMPLETED | CANCELLED
  startDate         DateTime?
  targetEndDate     DateTime?
  budget            Decimal?  @db.Decimal(12, 2)
  requiredHeadcount Int?
  siteAddress       String?
  latitude          Float?
  longitude         Float?
  workingDays       String[]  @default(["MON", "TUE", "WED", "THU", "FRI", "SAT"])
  baseTeamUserIds   String[]  @default([])          // crm CompanyUser ids
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  rosterDays ProjectRosterDay[]

  @@index([companyId, status])
  @@index([companyId, customerId])
  @@map("projects")
}

// Stored ONLY for dates that differ from the default roster. techUserIds is the
// complete effective crew for that date (frozen snapshot). isOff=true → no work.
model ProjectRosterDay {
  id          String   @id @default(uuid())
  companyId   String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  techUserIds String[] @default([])
  isOff       Boolean  @default(false)
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@unique([projectId, date])
  @@index([companyId, date])
  @@map("project_roster_days")
}
