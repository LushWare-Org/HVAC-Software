{
  "name": "crm-service",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "build": "nest build",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "dev:tunnel": "node scripts/dev-tunnel.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@google/genai": "^1.30.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/terminus": "^10.0.0",
    "@prisma/client": "^5.0.0",
    "@tscrm/auth-client": "workspace:*",
    "@tscrm/queue": "workspace:*",
    "@tscrm/types": "workspace:*",
    "@types/multer": "^2.1.0",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "csv-parse": "^6.2.1",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.1.0",
    "nodemailer": "^6.9.0",
    "openai": "^4.47.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "pdf-to-img": "^4.2.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@ngrok/ngrok": "^1.7.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/passport-jwt": "^4.0.0",
    "jest": "^29.5.0",
    "prisma": "^5.0.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/",
      "/src/prisma/generated/"
    ],
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@tscrm/auth-client$": "<rootDir>/../../../packages/auth-client/src/index.ts",
      "^@tscrm/types$": "<rootDir>/../../../packages/types/src/index.ts",
      "^@tscrm/queue$": "<rootDir>/../../../packages/queue/src/index.ts"
    }
  }
}
