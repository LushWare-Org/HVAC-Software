// ============================================================
// CRM Service — Prisma Schema
// Schema: crm (isolated from other services)
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("CRM_DATABASE_URL") // pgbouncer (runtime)
  directUrl = env("CRM_DIRECT_DATABASE_URL") // session mode (migrations / prisma studio)
}

// ---- Companies (tenants) ----
model Company {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String    @default("US")
  logoUrl     String?
  website     String?
  isActive    Boolean   @default(true)
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customers  Customer[]
  contacts   Contact[]
  leads      Lead[]
  agreements ServiceAgreement[]
  bookings   Booking[]
  users      CompanyUser[]

  @@map("companies")
}

// ---- Company Users (staff members with roles) ----
model CompanyUser {
  id                String    @id @default(uuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  auth0UserId       String?
  name              String
  email             String
  phone             String?
  passwordHash      String?
  mustResetPassword Boolean   @default(false) // Set true when admin provisions account with temp password
  role              String    @default("technician") // super_admin, company_admin, office_manager, dispatcher, technician
  isActive          Boolean   @default(true)
  approvalStatus    String    @default("APPROVED") // APPROVED | PENDING | REJECTED (PENDING for self-registered technicians)
  approvalNote      String? // rejection reason or admin notes
  skills            String[]  @default([]) // technician skills submitted at signup
  latitude          Float? // location submitted at signup
  longitude         Float?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([companyId, email])
  @@index([companyId])
  @@index([companyId, role])
  @@map("company_users")
}

// ---- Customers (business accounts or residential) ----
model Customer {
  id               String                   @id @default(uuid())
  companyId        String
  company          Company                  @relation(fields: [companyId], references: [id])
  type             CustomerType             @default(RESIDENTIAL)
  firstName        String
  lastName         String
  email            String?
  phone            String?
  mobile           String?
  address          String?
  city             String?
  state            String?
  zipCode          String?
  notes            String?
  source           String? // how they found us
  tags             String[] // flexible tagging
  isActive         Boolean                  @default(true)
  engagementStatus CustomerEngagementStatus @default(ACTIVE)
  auth0UserId      String? // when customer has portal access
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  contacts   Contact[]
  leads      Lead[]
  agreements ServiceAgreement[]
  bookings   Booking[]
  reviews    Review[]
  addresses  Address[]
  equipment  Equipment[]

  @@index([companyId])
  @@index([companyId, email])
  @@index([companyId, lastName])
  @@map("customers")
}

enum CustomerType {
  RESIDENTIAL
  COMMERCIAL
}

// ---- Contacts (multiple contacts per customer account) ----
model Contact {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String?
  phone      String?
  role       String? // e.g. "Property Manager", "Owner"
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([customerId])
  @@map("contacts")
}

// ---- Leads (pre-customer pipeline) ----
model Lead {
  id              String     @id @default(uuid())
  companyId       String
  company         Company    @relation(fields: [companyId], references: [id])
  customerId      String?
  customer        Customer?  @relation(fields: [customerId], references: [id])
  firstName       String
  lastName        String
  email           String?
  phone           String?
  source          String? // google, referral, website, etc.
  serviceInterest String? // what service they're interested in
  whatsappNo      String? // WhatsApp / mobile number
  type            String? // customer type / category
  status          LeadStatus @default(NEW)
  estimatedValue  Decimal?   @db.Decimal(10, 2)
  notes           String?
  assignedToId    String? // Auth0 user ID of assigned staff
  convertedAt     DateTime? // when lead became customer
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  addresses Address[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum CustomerEngagementStatus {
  ACTIVE
  QUOTE_SENT
  INVOICE_SENT
  JOB_BOOKED
  COMPLETED
  INACTIVE
}

// ---- Service Agreements / Maintenance Contracts ----
model ServiceAgreement {
  id           String          @id @default(uuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  customerId   String
  customer     Customer        @relation(fields: [customerId], references: [id])
  name         String
  description  String?
  status       AgreementStatus @default(DRAFT)
  startDate    DateTime
  endDate      DateTime?
  value        Decimal?        @db.Decimal(10, 2)
  billingCycle String? // monthly, annual
  autoRenew    Boolean         @default(false)
  signedAt     DateTime?
  signedByName String?
  documentUrl  String? // S3 key for signed PDF
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([companyId])
  @@index([customerId])
  @@map("service_agreements")
}

enum AgreementStatus {
  DRAFT
  SENT
  ACTIVE
  EXPIRED
  CANCELLED
}

// ---- Bookings (online booking portal requests) ----
model Booking {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  // For anonymous bookings (not yet a customer)
  guestName     String?
  guestEmail    String?
  guestPhone    String?
  serviceType   String
  description   String?
  preferredDate DateTime
  alternateDate DateTime?
  status        BookingStatus @default(PENDING)
  jobId         String? // set when converted to a job
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@map("bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CONVERTED
  CANCELLED
}

// ---- Reviews / Reputation Management ----
// A Review is authored by a customer and targets either a specific job
// (type = JOB, jobId + technicianId set) or the company as a whole
// (type = COMPANY, no jobId). Denormalized names avoid cross-service joins
// when listing reviews.
model Review {
  id        String     @id @default(uuid())
  companyId String
  type      ReviewType @default(JOB)

  // Author (customer)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerName String?

  // Target: a specific job + its assigned technician
  jobId          String?
  technicianId   String?
  technicianName String?

  rating      Int // 1-5
  comment     String?
  platform    String    @default("internal") // google, internal
  isPublished Boolean   @default(true) // customer-submitted reviews are live by default
  respondedAt DateTime?
  response    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([customerId])
  @@index([technicianId])
  @@index([companyId, type])
  @@index([jobId])
  @@map("reviews")
}

enum ReviewType {
  JOB // Review of a specific completed job / the assigned technician
  COMPANY // General review of the company / business
}

// ---- Addresses (multiple per customer or lead) ----
model Address {
  id         String    @id @default(uuid())
  companyId  String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       String    @default("Site") // Site, Billing, Shipping
  line1      String
  line2      String?
  city       String?
  state      String?
  postcode   String?
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([customerId])
  @@index([leadId])
  @@map("addresses")
}

// ---- Equipment (installed at customer sites) ----
model Equipment {
  id          String    @id @default(uuid())
  companyId   String
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String    @default("Boiler") // Boiler, AC Unit, Heat Pump, etc.
  brand       String?
  model       String?
  serialNo    String?
  installDate DateTime?
  warrantyEnd DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([customerId])
  @@map("equipment")
}
