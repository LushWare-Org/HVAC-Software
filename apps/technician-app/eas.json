{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "npm_config_user_agent": "pnpm"
      },
      "channel": "development"
    },
    "preview-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://nginx-gateway-536584181394.asia-northeast3.run.app/api",
        "EXPO_PUBLIC_WS_BASE_URL": "https://nginx-gateway-536584181394.asia-northeast3.run.app",
        "EXPO_PUBLIC_COMPANY_ID": "co-demo-001",
        "npm_config_user_agent": "pnpm"
      },
      "channel": "preview"
    },
    "production-apk": {
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://nginx-gateway-536584181394.asia-northeast3.run.app/api",
        "EXPO_PUBLIC_WS_BASE_URL": "https://nginx-gateway-536584181394.asia-northeast3.run.app",
        "EXPO_PUBLIC_COMPANY_ID": "co-demo-001",
        "npm_config_user_agent": "pnpm"
      },
      "channel": "production"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://nginx-gateway-536584181394.asia-northeast3.run.app/api",
        "EXPO_PUBLIC_WS_BASE_URL": "https://nginx-gateway-536584181394.asia-northeast3.run.app",
        "EXPO_PUBLIC_COMPANY_ID": "co-demo-001",
        "npm_config_user_agent": "pnpm"
      },
      "channel": "production"
    }
  }
}
