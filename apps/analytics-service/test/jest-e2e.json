{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@tscrm/types(.*)$": "<rootDir>/../../packages/types/src$1",
    "^@tscrm/auth-client(.*)$": "<rootDir>/../../packages/auth-client/src$1"
  }
}
