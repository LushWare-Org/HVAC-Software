// ============================================================
// Analytics Service — Prisma Schema
// Read-only cross-schema analytics using $queryRaw.
// All queries use schema-qualified table names:
//   crm.customers, crm.reviews
//   jobs.jobs, jobs.work_orders
//   finance.invoices, finance.payments
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("ANALYTICS_DATABASE_URL")
  directUrl = env("ANALYTICS_DIRECT_DATABASE_URL")
  // Point to the same PostgreSQL database used by all services.
  // The connection user must have SELECT access on crm, jobs, finance, scheduling schemas.
  // e.g. postgresql://analytics_ro:pass@localhost:5432/tscrm
}

// ── Minimal native model (health check / migration anchor) ──────────────────
// The analytics service does NOT write to any business schema.
// All reads are via $queryRaw with fully-qualified schema.table names.
// This model lives in the "analytics" schema and acts as a migration anchor.

model AnalyticsEvent {
  id          String   @id @default(uuid())
  companyId   String
  eventType   String   // "DASHBOARD_VIEWED", "EXPORT_GENERATED"
  userId      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("analytics_events")
}

// ── AI usage ────────────────────────────────────────────────────────────────
// One row per AI model call (or call skipped by the company switch / budget),
// written by AiUsageProcessor from the ai-usage queue that every service's AI
// gateway publishes to. Drives per-company cost reporting and monthly budgets.
model AiUsage {
  id           String   @id @default(uuid())
  companyId    String?
  service      String
  task         String
  ok           Boolean
  provider     String?
  model        String?
  attempts     Int
  latencyMs    Int
  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal? @db.Decimal(12, 6)
  skipped      String?
  error        String?
  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

// ── Kelvin ──────────────────────────────────────────────────────────────────
// What Kelvin told each person and what he did, written by KelvinProcessor from
// the kelvin-events queue. Feeds "Done today" and stops him repeating himself.
model KelvinEvent {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  userId      String   @map("user_id")
  itemId      String?  @map("item_id")
  type        String
  action      String?
  recordRef   String?  @map("record_ref")
  summary     String
  confirmedBy String?  @map("confirmed_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, userId, createdAt])
  @@index([companyId, itemId])
  @@map("kelvin_events")
}

// Each person's choice of how chatty Kelvin is.
model KelvinPrefs {
  companyId  String    @map("company_id")
  userId     String    @map("user_id")
  speakMode  String    @default("ALL") @map("speak_mode")
  quietUntil DateTime? @map("quiet_until") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([companyId, userId])
  @@map("kelvin_prefs")
}
