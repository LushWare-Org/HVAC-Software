// ============================================================
// Analytics Service — Prisma Schema
// Read-only cross-schema analytics using $queryRaw.
// All queries use schema-qualified table names:
//   crm.customers, crm.reviews
//   jobs.jobs, jobs.work_orders
//   finance.invoices, finance.payments
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("ANALYTICS_DATABASE_URL")
  // Point to the same PostgreSQL database used by all services.
  // The connection user must have SELECT access on crm, jobs, finance, scheduling schemas.
  // e.g. postgresql://analytics_ro:pass@localhost:5432/tscrm
}

// ── Minimal native model (health check / migration anchor) ──────────────────
// The analytics service does NOT write to any business schema.
// All reads are via $queryRaw with fully-qualified schema.table names.
// This model lives in the "analytics" schema and acts as a migration anchor.

model AnalyticsEvent {
  id        String   @id @default(uuid())
  companyId String
  eventType String // "DASHBOARD_VIEWED", "EXPORT_GENERATED"
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("analytics_events")
}
