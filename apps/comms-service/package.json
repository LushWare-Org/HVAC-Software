{
  "name": "comms-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.json",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prisma:generate": "prisma generate",
    "prisma:generate-marketing": "prisma generate --schema=prisma/marketing.prisma",
    "prisma:migrate-marketing": "prisma migrate dev --schema=prisma/marketing.prisma",
    "prisma:migrate-marketing-deploy": "prisma migrate deploy --schema=prisma/marketing.prisma",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/terminus": "^10.0.0",
    "@nestjs/websockets": "^11.1.17",
    "@prisma/client": "^5.0.0",
    "@sendgrid/eventwebhook": "^8.0.0",
    "@sendgrid/mail": "^8.1.0",
    "@tscrm/auth-client": "workspace:*",
    "@tscrm/queue": "workspace:*",
    "@tscrm/types": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/nodemailer": "^7.0.11",
    "bullmq": "^5.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "date-fns": "^3.6.0",
    "express": "^4.22.1",
    "firebase-admin": "^12.0.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.1.0",
    "luxon": "^3.7.2",
    "nodemailer": "^8.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "twilio": "^5.0.0",
    "uuid": "^9.0.0",
    "zipcode-to-timezone": "^0.0.9"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^9.0.0",
    "jest": "^29.5.0",
    "prisma": "^5.0.0",
    "rimraf": "^5.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/",
      "/src/marketing/prisma/generated/",
      "/src/prisma/generated/"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@tscrm/auth-client$": "<rootDir>/../../../packages/auth-client/src/index.ts",
      "^@tscrm/types$": "<rootDir>/../../../packages/types/src/index.ts",
      "^@tscrm/queue$": "<rootDir>/../../../packages/queue/src/index.ts"
    }
  }
}
