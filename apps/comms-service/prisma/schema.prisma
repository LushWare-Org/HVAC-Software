// ============================================================
// Comms Service — Prisma Schema
// Database: PostgreSQL (Supabase) — migrated from MongoDB
// Schema:   comms
// Messages are now a separate relational table instead of
// embedded MongoDB documents — cleaner and fully relational.
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("COMMS_DATABASE_URL")
  directUrl = env("COMMS_DIRECT_DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────

enum Channel {
  SMS
  EMAIL
  PUSH
  IN_APP
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
  UNSUBSCRIBED
}

enum ThreadStatus {
  ACTIVE
  RESOLVED
  SPAM
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum TemplateType {
  APPOINTMENT_REMINDER
  JOB_STATUS_UPDATE
  INVOICE_SENT
  PAYMENT_RECEIVED
  REVIEW_REQUEST
  WELCOME
  CUSTOM
}

enum AutomationTrigger {
  JOB_STATUS_CHANGED
  INVOICE_SENT
  PAYMENT_RECEIVED
  QUOTE_APPROVED
  APPOINTMENT_BOOKED
  MANUAL
}

// ── Notification — one delivery attempt per channel per event ─────────────

model Notification {
  id                 String         @id @default(uuid())
  companyId          String
  customerId         String?
  jobId              String?
  invoiceId          String?
  quoteId            String?
  recipientId        String
  recipientName      String?
  recipientEmail     String?
  recipientPhone     String?
  recipientPushToken String?
  channel            Channel
  subject            String?
  body               String
  status             DeliveryStatus @default(QUEUED)
  externalId         String?
  providerResponse   String?
  error              String?
  isRead             Boolean        @default(false)
  title              String?
  type               String?
  scheduledAt        DateTime?
  sentAt             DateTime?
  deliveredAt        DateTime?
  failedAt           DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([companyId, status])
  @@index([companyId, isRead])
  @@index([companyId, customerId])
  @@index([companyId, jobId])
  @@index([scheduledAt])
}

// ── MessageThread — conversation between company and a customer, or staff ──

model MessageThread {
  id               String        @id @default(uuid())
  companyId        String
  customerId       String?
  customerName     String?
  customerPhone    String?
  customerEmail    String?
  participantIds   String[]      @default([])
  participantNames String[]      @default([])
  subject          String?
  jobId            String?
  status           ThreadStatus  @default(ACTIVE)
  unreadCount      Int           @default(0)
  lastMessageAt    DateTime?
  lastMessageBody  String?
  messages         Message[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([companyId, customerPhone])
  @@index([lastMessageAt])
}

// ── Message — individual message in a thread (was embedded in MongoDB) ────

model Message {
  id          String           @id @default(uuid())
  threadId    String
  thread      MessageThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId    String
  senderName  String
  direction   MessageDirection
  body        String
  channel     Channel
  mediaUrls   String[]         @default([])
  twilioSid   String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([threadId])
  @@index([threadId, createdAt])
}

// ── NotificationTemplate — reusable templates per company ────────────────

model NotificationTemplate {
  id        String       @id @default(uuid())
  companyId String
  name      String
  type      TemplateType
  channel   Channel
  subject   String?
  body      String
  variables String[]     @default([])
  isActive  Boolean      @default(true)
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([companyId, type])
  @@index([companyId, channel])
}

// ── AutomationRule — when notifications are triggered automatically ───────

model AutomationRule {
  id           String            @id @default(uuid())
  companyId    String
  name         String
  isActive     Boolean           @default(true)
  trigger      AutomationTrigger
  conditions   String
  actions      String
  delayMinutes Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([companyId, trigger])
  @@index([companyId, isActive])
}

// ── WebPushSubscription — browser push subscription per user/device ───────

model WebPushSubscription {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, userId])
}

// ── DeliveryLog — immutable audit log of every send attempt ──────────────

model DeliveryLog {
  id              String         @id @default(uuid())
  companyId       String
  notificationId  String?
  channel         Channel
  recipient       String
  status          DeliveryStatus
  provider        String
  externalId      String?
  requestPayload  String?
  responsePayload String?
  durationMs      Int?
  error           String?
  createdAt       DateTime       @default(now())

  @@index([companyId, channel])
  @@index([companyId, status])
  @@index([createdAt])
}

// ── ActivityLog — super-admin cross-tenant monitoring feed ───────────────
// One row per API call across every service. Written by ActivityLogProcessor
// (activity-log/activity-log.processor.ts) consuming the ACTIVITY_LOG BullMQ
// queue; queried only by Role.SUPER_ADMIN via ActivityLogController.

model ActivityLog {
  id              String   @id @default(uuid())
  companyId       String?
  companyName     String
  service         String
  method          String
  path            String
  actorUserId     String?
  actorName       String?
  actorRole       String?
  action          String
  description     String
  status          String
  statusCode      Int
  durationMs      Int
  requestSummary  Json?
  responseSummary Json?
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([action, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}
