{
  "expo": {
    "name": "HVACtor.ai",
    "slug": "ts-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tscustomer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tscrm.customer",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock HVACtor.ai with Face ID instead of typing your password.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.tscrm.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2563EB"
        }
      ],
      "expo-local-authentication",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "676976b5-812c-42ad-af93-47be2dce4eb6"
      }
    },
    "owner": "ravishan12",
    "updates": {
      "url": "https://u.expo.dev/676976b5-812c-42ad-af93-47be2dce4eb6"
    }
  }
}
