// ============================================================
// Finance Service — Prisma Schema
// Schema: finance (within the shared tscrm PostgreSQL database)
// ============================================================

generator client {
  provider        = "prisma-client-js"
  output          = "../src/prisma/generated"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["finance"]
}

// ============================================================
// ENUMS
// ============================================================

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED

  @@schema("finance")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID

  @@schema("finance")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED

  @@schema("finance")
}

enum PaymentMethod {
  CARD
  ACH
  CASH
  CHECK
  OTHER

  @@schema("finance")
}

enum LineItemCategory {
  LABOUR
  PARTS
  MATERIALS
  EQUIPMENT_RENTAL
  TRAVEL
  OTHER

  @@schema("finance")
}

enum DiscountType {
  PERCENTAGE
  FIXED

  @@schema("finance")
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY

  @@schema("finance")
}

enum ExpenseCategory {
  PARTS
  FUEL
  TOOLS
  SUBCONTRACTOR
  OTHER

  @@schema("finance")
}

// ============================================================
// QUOTES
// ============================================================

model Quote {
  id            String  @id @default(uuid())
  companyId     String
  quoteNumber   String // e.g. QUOTE-2024-0001 (auto-generated)
  jobId         String? // optional link to a job in the jobs schema
  customerId    String // cross-schema ref to crm.customers
  customerName  String
  customerEmail String
  title         String
  description   String?

  status     QuoteStatus @default(DRAFT)
  validUntil DateTime?

  // Financials — all stored as Decimal for exact money math (no floating point)
  subtotal       Decimal       @default(0) @db.Decimal(10, 2)
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(10, 2) // % or fixed amount
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  taxRate        Decimal       @default(0) @db.Decimal(5, 4) // 0.0825 = 8.25%
  taxAmount      Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @default(0) @db.Decimal(10, 2)

  notes  String?
  terms  String?
  pdfUrl String? // S3 object key (not full URL — presigned on demand)

  // E-signature / approval (simple token-based — no third-party dependency)
  approvalToken   String?   @unique // UUID sent in approval email
  approvedAt      DateTime?
  approvedByName  String?
  approvedByEmail String?

  // Lifecycle timestamps
  sentAt   DateTime?
  viewedAt DateTime?

  createdByUserId String
  lineItems       QuoteLineItem[]
  invoices        Invoice[]       @relation("QuoteInvoices")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, quoteNumber])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@schema("finance")
}

model QuoteLineItem {
  id          String           @id @default(uuid())
  quoteId     String
  quote       Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  category    LineItemCategory @default(LABOUR)
  quantity    Decimal          @db.Decimal(10, 3)
  unitPrice   Decimal          @db.Decimal(10, 2)
  lineTotal   Decimal          @db.Decimal(10, 2) // quantity × unitPrice
  taxable     Boolean          @default(true)
  sortOrder   Int              @default(0)

  @@index([quoteId])
  @@schema("finance")
}

// ============================================================
// INVOICES
// ============================================================

model Invoice {
  id            String  @id @default(uuid())
  companyId     String
  invoiceNumber String // e.g. INV-2024-0001
  quoteId       String? // set when converted from a quote
  quote         Quote?  @relation("QuoteInvoices", fields: [quoteId], references: [id])
  jobId         String? // cross-schema ref to jobs.job
  workOrderId   String? // cross-schema ref to jobs.work_order
  customerId    String
  customerName  String
  customerEmail String

  status  InvoiceStatus @default(DRAFT)
  dueDate DateTime?
  dueDays Int           @default(30) // payment terms (net 30)

  // Financials
  subtotal       Decimal @default(0) @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  taxRate        Decimal @default(0) @db.Decimal(5, 4)
  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @default(0) @db.Decimal(10, 2)
  amountPaid     Decimal @default(0) @db.Decimal(10, 2)
  balanceDue     Decimal @default(0) @db.Decimal(10, 2)

  notes  String?
  terms  String?
  pdfUrl String?

  // Stripe
  stripePaymentIntentId String?
  stripePaymentUrl      String? // hosted payment page URL

  // Lifecycle timestamps
  sentAt   DateTime?
  paidAt   DateTime?
  voidedAt DateTime?

  createdByUserId     String
  recurringScheduleId String? // if generated by a recurring schedule
  recurringSchedule   RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id])

  lineItems InvoiceLineItem[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, dueDate])
  @@schema("finance")
}

model InvoiceLineItem {
  id          String           @id @default(uuid())
  invoiceId   String
  invoice     Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  category    LineItemCategory @default(LABOUR)
  quantity    Decimal          @db.Decimal(10, 3)
  unitPrice   Decimal          @db.Decimal(10, 2)
  lineTotal   Decimal          @db.Decimal(10, 2)
  taxable     Boolean          @default(true)
  sortOrder   Int              @default(0)

  @@index([invoiceId])
  @@schema("finance")
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id            String        @id @default(uuid())
  companyId     String
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CARD)
  status        PaymentStatus @default(PENDING)

  // Stripe identifiers
  stripePaymentIntentId String?
  stripeChargeId        String?

  paidAt DateTime?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, invoiceId])
  @@index([stripePaymentIntentId])
  @@schema("finance")
}

// ============================================================
// RECURRING BILLING SCHEDULES
// ============================================================

model RecurringSchedule {
  id              String             @id @default(uuid())
  companyId       String
  customerId      String
  customerName    String
  customerEmail   String
  description     String // e.g. "Annual HVAC Maintenance Contract"
  frequency       RecurringFrequency @default(ANNUALLY)
  amount          Decimal            @db.Decimal(10, 2)
  taxRate         Decimal            @default(0) @db.Decimal(5, 4)
  nextBillingDate DateTime
  isActive        Boolean            @default(true)
  jobId           String? // optional: re-creates a job on each cycle
  invoices        Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, isActive, nextBillingDate])
  @@schema("finance")
}

// ============================================================
// EXPENSES (job cost tracking)
// ============================================================

model Expense {
  id              String          @id @default(uuid())
  companyId       String
  jobId           String? // cross-schema ref
  technicianId    String? // who submitted it
  category        ExpenseCategory @default(OTHER)
  description     String
  amount          Decimal         @db.Decimal(10, 2)
  vendor          String?
  receiptUrl      String? // S3 object key
  expenseDate     DateTime        @default(now())
  isReimbursable  Boolean         @default(false)
  createdByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, jobId])
  @@index([companyId, expenseDate])
  @@schema("finance")
}
