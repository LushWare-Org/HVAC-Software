<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: "Helvetica Neue", Arial, sans-serif; font-size: 12px; color: #0f172a; background: #eef2f7; }
    .page { width: 100%; max-width: 860px; margin: 0 auto; padding: 26px; }
    .sheet { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 10px; overflow: hidden; box-shadow: 0 10px 22px rgba(15, 23, 42, 0.06); }
    .hero { background: linear-gradient(120deg, #f8fbff, #edf5ff); color: #0f172a; padding: 28px 32px 24px; border-bottom: 1px solid #dbe7ff; }
    .hero-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
    .eyebrow { font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: #2563eb; margin-bottom: 8px; }
    .brand-name { font-size: 24px; font-weight: 700; line-height: 1.1; }
    .brand-address { margin-top: 8px; max-width: 320px; font-size: 11px; line-height: 1.6; color: #475569; white-space: pre-line; }
    .doc-card { min-width: 220px; padding: 14px 16px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; }
    .doc-label { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #64748b; }
    .doc-number { margin-top: 6px; font-size: 24px; font-weight: 700; letter-spacing: -0.02em; }
    .status-badge { display: inline-block; margin-top: 10px; padding: 4px 9px; border: 1px solid #93c5fd; border-radius: 999px; font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #1d4ed8; background: #eff6ff; }
    .status-DRAFT, .status-SENT, .status-PARTIALLY_PAID, .status-PAID, .status-OVERDUE, .status-VOID { color: #1d4ed8; background: #eff6ff; border-color: #93c5fd; }
    .hero-summary { margin-top: 18px; display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 10px; }
    .summary-card { border-radius: 8px; padding: 14px 16px; background: #ffffff; border: 1px solid #cbd5e1; }
    .summary-label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.12em; color: #64748b; }
    .summary-value { margin-top: 6px; font-size: 20px; font-weight: 700; }
    .summary-copy { margin-top: 6px; font-size: 12px; line-height: 1.55; color: #475569; }
    .body { padding: 28px 32px 32px; }
    .alert { margin-bottom: 14px; border: 1px solid #7e7e7e; border-radius: 6px; padding: 10px 12px; background: #efefef; color: #111111; font-size: 10px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
    .info-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-bottom: 20px; }
    .info-card { border: 1px solid #c8c8c8; border-radius: 6px; padding: 12px 14px; background: #f7f7f7; }
    .info-label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.11em; color: #555555; margin-bottom: 5px; }
    .info-value { font-size: 12px; font-weight: 600; color: #111111; line-height: 1.5; }
    .headline { font-size: 22px; font-weight: 700; color: #111111; line-height: 1.2; letter-spacing: -0.01em; }
    .subcopy { margin-top: 8px; margin-bottom: 18px; font-size: 12px; line-height: 1.6; color: #333333; }
    table { width: 100%; border-collapse: collapse; }
    thead th { padding: 10px 11px; background: #efefef; border-bottom: 1px solid #bcbcbc; border-top: 1px solid #bcbcbc; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #333333; text-align: left; }
    tbody td { padding: 12px 11px; border-bottom: 1px solid #dcdcdc; vertical-align: top; }
    tbody tr:nth-child(even) { background: #fafafa; }
    .td-right { text-align: right; }
    .item-title { font-weight: 600; color: #111111; }
    .item-category { margin-top: 3px; font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em; color: #555555; }
    .totals-wrap { margin-top: 18px; display: grid; grid-template-columns: 1fr 330px; gap: 12px; align-items: start; }
    .pay-card { border: 1px solid #bcbcbc; border-radius: 6px; padding: 14px 16px; background: #f7f7f7; }
    .pay-card-title { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #222222; margin-bottom: 6px; }
    .pay-card-text { font-size: 12px; line-height: 1.6; color: #222222; }
    .pay-button { display: inline-block; margin-top: 10px; padding: 9px 14px; border-radius: 999px; background: #111111; color: #ffffff; font-size: 11px; font-weight: 700; text-decoration: none; }
    .totals-card { border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden; background: #ffffff; }
    .totals-card table { width: 100%; }
    .totals-card td { padding: 10px 14px; }
    .totals-card .label { color: #333333; }
    .totals-card .value { text-align: right; font-weight: 600; color: #111111; }
    .paid-row .label, .paid-row .value { color: #111111; }
    .balance-row { background: #efefef; }
    .balance-row .label, .balance-row .value { color: #111111; font-weight: 700; }
    .grand-total { background: #1d4ed8; color: #ffffff; }
    .grand-total td { padding-top: 12px; padding-bottom: 12px; }
    .payment-section { margin-top: 20px; border: 1px solid #c8c8c8; border-radius: 6px; padding: 14px 16px; background: #ffffff; }
    .section-heading { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #555555; margin-bottom: 8px; }
    .notes-grid { margin-top: 20px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .note-card { border: 1px solid #c8c8c8; border-radius: 6px; padding: 13px 14px; background: #ffffff; }
    .note-label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em; color: #555555; margin-bottom: 6px; }
    .note-text { font-size: 12px; line-height: 1.6; color: #222222; white-space: pre-line; }
    .footer { margin-top: 20px; padding-top: 13px; border-top: 1px solid #c8c8c8; display: flex; justify-content: space-between; gap: 10px; font-size: 10px; color: #555555; }
  </style>
</head>
<body>
  <div class="page">
    <div class="sheet">
      <div class="hero">
        <div class="hero-top">
          <div>
            <div class="eyebrow">Client billing statement</div>
            <div class="brand-name">{{companyName}}</div>
            <div class="brand-address">{{companyAddress}}</div>
          </div>
          <div class="doc-card">
            <div class="doc-label">Invoice</div>
            <div class="doc-number">{{invoiceNumber}}</div>
            <span class="status-badge status-{{status}}">{{status}}</span>
          </div>
        </div>
        <div class="hero-summary">
          <div class="summary-card">
            <div class="summary-label">Bill to</div>
            <div class="summary-value">{{customerName}}</div>
            <div class="summary-copy">{{customerEmail}}</div>
          </div>
          <div class="summary-card">
            <div class="summary-label">Balance due</div>
            <div class="summary-value">{{#if balanceDue}}{{balanceDueFmt}}{{else}}{{totalFmt}}{{/if}}</div>
            <div class="summary-copy">Payment due {{dueDate}}</div>
          </div>
        </div>
      </div>

      <div class="body">
        {{#if isOverdue}}
        <div class="alert">Past due: please arrange payment immediately</div>
        {{/if}}

        <div class="info-grid">
          <div class="info-card">
            <div class="info-label">Invoice date</div>
            <div class="info-value">{{invoiceDate}}</div>
          </div>
          <div class="info-card">
            <div class="info-label">Due date</div>
            <div class="info-value">{{dueDate}}</div>
          </div>
          <div class="info-card">
            <div class="info-label">Quote reference</div>
            <div class="info-value">{{#if quoteNumber}}{{quoteNumber}}{{else}}Not linked{{/if}}</div>
          </div>
          <div class="info-card">
            <div class="info-label">Status</div>
            <div class="info-value">{{status}}</div>
          </div>
        </div>

        <div class="headline">Invoice details</div>
        <div class="subcopy">This invoice summarizes the completed services and charges associated with your work order. Retain this PDF for finance and project records.</div>

        <table>
          <thead>
            <tr>
              <th style="width:40%">Description</th>
              <th style="width:16%">Category</th>
              <th style="width:8%">Qty</th>
              <th style="width:16%">Unit price</th>
              <th style="width:8%">Tax</th>
              <th style="width:12%">Total</th>
            </tr>
          </thead>
          <tbody>
            {{#each lineItems}}
            <tr>
              <td>
                <div class="item-title">{{description}}</div>
              </td>
              <td><div class="item-category">{{category}}</div></td>
              <td class="td-right">{{quantity}}</td>
              <td class="td-right">{{unitPriceFmt}}</td>
              <td class="td-right">{{#if taxable}}Yes{{else}}No{{/if}}</td>
              <td class="td-right">{{lineTotalFmt}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>

        <div class="totals-wrap">
          <div>
            {{#if stripePaymentUrl}}
            <div class="pay-card">
              <div class="pay-card-title">Online payment</div>
              <div class="pay-card-text">A secure payment link is available for this invoice. Use it to pay the outstanding balance online.</div>
              <a class="pay-button" href="{{stripePaymentUrl}}">Pay {{#if balanceDue}}{{balanceDueFmt}}{{else}}{{totalFmt}}{{/if}} online</a>
            </div>
            {{/if}}
          </div>
          <div class="totals-card">
            <table>
              <tbody>
                <tr>
                  <td class="label">Subtotal</td>
                  <td class="value">{{subtotalFmt}}</td>
                </tr>
                {{#if hasDiscount}}
                <tr>
                  <td class="label">Discount</td>
                  <td class="value">-{{discountAmountFmt}}</td>
                </tr>
                {{/if}}
                <tr>
                  <td class="label">Tax ({{taxRatePct}}%)</td>
                  <td class="value">{{taxAmountFmt}}</td>
                </tr>
                <tr class="grand-total">
                  <td>Invoice total</td>
                  <td class="value">{{totalFmt}}</td>
                </tr>
                {{#if amountPaid}}
                <tr class="paid-row">
                  <td class="label">Amount paid</td>
                  <td class="value">-{{amountPaidFmt}}</td>
                </tr>
                {{/if}}
                {{#if balanceDue}}
                <tr class="balance-row">
                  <td class="label">Balance due</td>
                  <td class="value">{{balanceDueFmt}}</td>
                </tr>
                {{/if}}
              </tbody>
            </table>
          </div>
        </div>

        {{#if payments.length}}
        <div class="payment-section">
          <div class="section-heading">Payment history</div>
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Method</th>
                <th style="text-align:right">Amount</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {{#each payments}}
              <tr>
                <td>{{paidAtFmt}}</td>
                <td>{{paymentMethod}}</td>
                <td class="td-right">{{amountFmt}}</td>
                <td>{{status}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{/if}}

        <div class="notes-grid">
          {{#if notes}}
          <div class="note-card">
            <div class="note-label">Notes</div>
            <div class="note-text">{{notes}}</div>
          </div>
          {{/if}}
          {{#if terms}}
          <div class="note-card">
            <div class="note-label">Terms and conditions</div>
            <div class="note-text">{{terms}}</div>
          </div>
          {{/if}}
        </div>

        <div class="footer">
          <div>Generated {{generatedAt}} by T&amp;S CRM</div>
          <div>Payment due {{dueDate}}</div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
