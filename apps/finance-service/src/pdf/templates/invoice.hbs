<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #1a1a2e; background: #fff; }
    .page { padding: 48px 52px; max-width: 800px; margin: 0 auto; }

    .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 36px; }
    .brand-name { font-size: 22px; font-weight: 700; color: #1d4ed8; }
    .brand-address { font-size: 11px; color: #6b7280; margin-top: 4px; line-height: 1.5; }
    .doc-title { text-align: right; }
    .doc-label { font-size: 28px; font-weight: 800; color: #1d4ed8; letter-spacing: -1px; }
    .doc-number { font-size: 13px; color: #6b7280; margin-top: 2px; }

    .status-badge { display: inline-block; padding: 3px 10px; border-radius: 9999px; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-top: 8px; }
    .status-DRAFT         { background: #f3f4f6; color: #6b7280; }
    .status-SENT          { background: #dbeafe; color: #1d4ed8; }
    .status-PARTIALLY_PAID{ background: #fef3c7; color: #d97706; }
    .status-PAID          { background: #dcfce7; color: #16a34a; }
    .status-OVERDUE       { background: #fee2e2; color: #dc2626; }
    .status-VOID          { background: #f3f4f6; color: #9ca3af; }

    .meta { display: flex; gap: 40px; margin-bottom: 32px; }
    .meta-block { flex: 1; }
    .meta-label { font-size: 10px; font-weight: 700; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 4px; }
    .meta-value { font-size: 13px; color: #111827; line-height: 1.5; }

    hr { border: none; border-top: 1px solid #e5e7eb; margin: 24px 0; }

    table { width: 100%; border-collapse: collapse; }
    thead th { background: #f9fafb; font-size: 11px; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.6px; padding: 10px 12px; border-bottom: 2px solid #e5e7eb; }
    thead th:last-child, thead th:nth-last-child(2), thead th:nth-last-child(3) { text-align: right; }
    tbody tr:nth-child(even) { background: #f9fafb; }
    tbody td { padding: 10px 12px; vertical-align: top; border-bottom: 1px solid #f3f4f6; }
    .td-right { text-align: right; }
    .item-category { font-size: 10px; color: #9ca3af; margin-top: 2px; }

    .totals { margin-top: 0; }
    .totals table { width: 320px; margin-left: auto; }
    .totals td { padding: 6px 12px; }
    .totals .label { color: #6b7280; }
    .totals .value { text-align: right; font-weight: 500; }
    .totals .total-row { border-top: 2px solid #e5e7eb; font-size: 15px; font-weight: 800; color: #111827; }
    .totals .total-row td { padding-top: 10px; }
    .totals .paid-row { color: #16a34a; }
    .totals .balance-row { color: #dc2626; font-size: 16px; font-weight: 800; }

    .payment-section { margin-top: 32px; }
    .section-heading { font-size: 12px; font-weight: 700; color: #374151; margin-bottom: 10px; }
    .payment-table td { font-size: 12px; }

    .pay-button-block { margin-top: 24px; text-align: center; }
    .pay-button { display: inline-block; background: #1d4ed8; color: #fff; font-size: 14px; font-weight: 700; padding: 12px 36px; border-radius: 6px; text-decoration: none; }

    .notes-section { margin-top: 32px; display: flex; gap: 32px; }
    .notes-block { flex: 1; }
    .section-label { font-size: 10px; font-weight: 700; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 6px; }
    .section-text { font-size: 12px; color: #374151; line-height: 1.6; }

    .footer { margin-top: 48px; padding-top: 16px; border-top: 1px solid #e5e7eb; display: flex; justify-content: space-between; }
    .footer-left, .footer-right { font-size: 11px; color: #9ca3af; }

    .overdue-banner { background: #fef2f2; border: 1px solid #fca5a5; border-radius: 6px; padding: 12px 16px; margin-bottom: 20px; font-size: 12px; color: #b91c1c; font-weight: 600; }
  </style>
</head>
<body>
<div class="page">

  <!-- Header -->
  <div class="header">
    <div>
      <div class="brand-name">{{companyName}}</div>
      <div class="brand-address">{{companyAddress}}</div>
    </div>
    <div class="doc-title">
      <div class="doc-label">INVOICE</div>
      <div class="doc-number"># {{invoiceNumber}}</div>
      <div><span class="status-badge status-{{status}}">{{status}}</span></div>
    </div>
  </div>

  {{#if isOverdue}}
  <div class="overdue-banner">⚠ This invoice is past due. Please arrange payment immediately.</div>
  {{/if}}

  <!-- Meta -->
  <div class="meta">
    <div class="meta-block">
      <div class="meta-label">Bill To</div>
      <div class="meta-value">
        <strong>{{customerName}}</strong><br/>
        {{customerEmail}}
      </div>
    </div>
    <div class="meta-block">
      <div class="meta-label">Invoice Date</div>
      <div class="meta-value">{{invoiceDate}}</div>
    </div>
    <div class="meta-block">
      <div class="meta-label">Due Date</div>
      <div class="meta-value" style="{{#if isOverdue}}color:#dc2626;font-weight:700{{/if}}">{{dueDate}}</div>
    </div>
    {{#if quoteNumber}}
    <div class="meta-block">
      <div class="meta-label">Quote Ref</div>
      <div class="meta-value">{{quoteNumber}}</div>
    </div>
    {{/if}}
  </div>

  <hr/>

  <!-- Line Items -->
  <table>
    <thead>
      <tr>
        <th style="width:46%">Description</th>
        <th style="width:12%">Category</th>
        <th style="width:8%">Qty</th>
        <th style="width:13%">Unit Price</th>
        <th style="width:9%">Tax</th>
        <th style="width:12%">Total</th>
      </tr>
    </thead>
    <tbody>
      {{#each lineItems}}
      <tr>
        <td>{{description}}</td>
        <td><span class="item-category">{{category}}</span></td>
        <td class="td-right">{{quantity}}</td>
        <td class="td-right">{{unitPriceFmt}}</td>
        <td class="td-right">{{#if taxable}}Yes{{else}}—{{/if}}</td>
        <td class="td-right">{{lineTotalFmt}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- Totals -->
  <div class="totals">
    <table>
      <tbody>
        <tr>
          <td class="label">Subtotal</td>
          <td class="value">{{subtotalFmt}}</td>
        </tr>
        {{#if hasDiscount}}
        <tr>
          <td class="label">Discount</td>
          <td class="value" style="color:#16a34a">−{{discountAmountFmt}}</td>
        </tr>
        {{/if}}
        <tr>
          <td class="label">Tax ({{taxRatePct}}%)</td>
          <td class="value">{{taxAmountFmt}}</td>
        </tr>
        <tr class="total-row">
          <td><strong>Invoice Total</strong></td>
          <td class="value"><strong>{{totalFmt}}</strong></td>
        </tr>
        {{#if amountPaid}}
        <tr class="paid-row">
          <td class="label">Amount Paid</td>
          <td class="value">−{{amountPaidFmt}}</td>
        </tr>
        {{/if}}
        {{#if balanceDue}}
        <tr class="balance-row">
          <td><strong>Balance Due</strong></td>
          <td class="value"><strong>{{balanceDueFmt}}</strong></td>
        </tr>
        {{/if}}
      </tbody>
    </table>
  </div>

  <!-- Stripe Pay Button -->
  {{#if stripePaymentUrl}}
  <div class="pay-button-block">
    <a class="pay-button" href="{{stripePaymentUrl}}">Pay {{balanceDueFmt}} Online →</a>
  </div>
  {{/if}}

  <!-- Payment history -->
  {{#if payments.length}}
  <div class="payment-section">
    <div class="section-heading">Payment History</div>
    <table class="payment-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Method</th>
          <th style="text-align:right">Amount</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {{#each payments}}
        <tr>
          <td>{{paidAtFmt}}</td>
          <td>{{paymentMethod}}</td>
          <td class="td-right">{{amountFmt}}</td>
          <td>{{status}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  <!-- Notes / Terms -->
  <div class="notes-section">
    {{#if notes}}
    <div class="notes-block">
      <div class="section-label">Notes</div>
      <div class="section-text">{{notes}}</div>
    </div>
    {{/if}}
    {{#if terms}}
    <div class="notes-block">
      <div class="section-label">Terms &amp; Conditions</div>
      <div class="section-text">{{terms}}</div>
    </div>
    {{/if}}
  </div>

  <!-- Footer -->
  <div class="footer">
    <div class="footer-left">Generated {{generatedAt}} · T&amp;S CRM</div>
    <div class="footer-right">Payment due {{dueDate}}</div>
  </div>

</div>
</body>
</html>
