# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Turbo
.turbo/

# Docker volumes (local dev data)
.docker-data/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/
.nyc_output/

# Prisma generated
prisma/generated/

# Word/Office docs (version controlled separately)
*.docx
*.xlsx
*.pptx

# Misc
*.tsbuildinfo

# Database export archives (share manually, not via git)
exports/
apps/admin-dashboard/.env.production

# Superpowers brainstorming session files (mockups, local only)
.superpowers/

# Firebase hosting deploy caches (regenerated on every deploy)
.firebase/

# Prisma clients are generated during the Docker build (prisma generate)
**/src/prisma/generated/
**/src/*/prisma/generated/

# npm lockfile. This repo is pnpm-only (the preinstall hook rejects npm), and a
# stray package-lock.json makes EAS Build detect npm and fail the install step.
package-lock.json
yarn.lock

# Deploy scripts that carry live credentials inline (OpenAI, SendGrid, Brevo
# SMTP, Stripe, the Supabase password). They are operational tooling, not
# source, and GitHub push protection rejects them for good reason. Keep them
# local, or move the secrets to Secret Manager before tracking them.
scripts/deploy-chat-service.sh
scripts/deploy-crm-service.sh
scripts/deploy-integrations.sh
scripts/migrate-comms.sh
scripts/update-comms-envvars.sh
