# ─────────────────────────────────────────────────────────────────
#  T&S Services CRM — Flow Test Environment
#
#  Copy this file and rename to .env.test.local to override values.
#  Run: cp .env.test .env.test.local
# ─────────────────────────────────────────────────────────────────

# ── Auth bypass (required for integration tests) ──────────────────
# This flag tells all NestJS services to skip Auth0 JWT verification
# and accept x-test-company-id header instead.
# NEVER set this in production.
BYPASS_AUTH=true
NODE_ENV=test

# ── Service URLs (defaults assume local Docker Compose) ───────────
CRM_URL=http://localhost:3001
JOBS_URL=http://localhost:3002
SCHEDULING_URL=http://localhost:3003
FINANCE_URL=http://localhost:3004
COMMS_URL=http://localhost:3005
ANALYTICS_URL=http://localhost:3006

# ── Test identity ─────────────────────────────────────────────────
# These are injected into request headers when BYPASS_AUTH=true
TEST_COMPANY_ID=co-demo-001
TEST_USER_ID=user-admin-001
TEST_USER_EMAIL=admin@demo.tscrm.dev
TEST_USER_ROLE=COMPANY_ADMIN
TEST_USER_NAME=Demo Admin

# ── Technician identity (used in dispatch/GPS flows) ──────────────
TEST_TECH_ID=user-tech-001
TEST_TECH_NAME=Carlos Martinez
TEST_TECH_EMAIL=carlos@demo.tscrm.dev

# ── Request configuration ─────────────────────────────────────────
# Timeout in milliseconds for each HTTP request
REQUEST_TIMEOUT_MS=10000

# ── Optional: Custom service URLs for CI/CD or remote environments ─
# Uncomment and modify if services are running elsewhere:
# CRM_URL=http://api.staging.tscrm.dev/crm
# JOBS_URL=http://api.staging.tscrm.dev/jobs
