# ============================================================
# T&S CRM — Environment Variables Template
# Copy this file to .env:  cp .env.example .env
# Or just run:              ./scripts/setup.sh
# NEVER commit .env to git
# ============================================================

# ----- Shared Infrastructure -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tscrm
POSTGRES_USER=tscrm_user
POSTGRES_PASSWORD=tscrm_pass

REDIS_HOST=localhost
REDIS_PORT=6379

MONGODB_URI=mongodb://localhost:27017/tscrm_comms?replicaSet=rs0

# ----- Auth -----
# For local dev, BYPASS_AUTH=true skips Auth0 and uses local JWT.
# Set to false only when you have Auth0 configured.
BYPASS_AUTH=true
JWT_SECRET=tscrm-local-jwt-secret-change-in-production

# Auth0 (optional — only needed when BYPASS_AUTH=false)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.tscrm.com

# ----- CRM Service (port 3001) -----
CRM_DATABASE_URL=postgresql://tscrm_user:tscrm_pass@localhost:5432/tscrm?schema=crm
CRM_PORT=3001

# ----- Job Management Service (port 3002) -----
JOBS_DATABASE_URL=postgresql://tscrm_user:tscrm_pass@localhost:5432/tscrm?schema=jobs
JOBS_PORT=3002

# ----- Scheduling Service (port 3003 — Go) -----
SCHEDULING_DATABASE_URL=postgresql://tscrm_user:tscrm_pass@localhost:5432/tscrm?schema=scheduling
SCHEDULING_PORT=3003

# ----- Finance Service (port 3004) -----
FINANCE_DATABASE_URL=postgresql://tscrm_user:tscrm_pass@localhost:5432/tscrm?schema=finance
FINANCE_PORT=3004
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
CHROMIUM_PATH=

# ----- Communication Service (port 3005) -----
COMMS_PORT=3005
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
SENDGRID_API_KEY=SG.xxxxxxxx
EXPO_ACCESS_TOKEN=xxxxxxxx

# ----- Analytics Service (port 3006) -----
ANALYTICS_DATABASE_URL=postgresql://tscrm_user:tscrm_pass@localhost:5432/tscrm?schema=analytics
ANALYTICS_PORT=3006

# ----- Inventory Service (port 3007) -----
INVENTORY_DATABASE_URL=postgresql://tscrm_user:tscrm_pass@localhost:5432/tscrm?schema=inventory
INVENTORY_PORT=3007

# ----- Object Storage (MinIO for local dev) -----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tscrm-files
S3_REGION=us-east-1

# ----- Node environment -----
NODE_ENV=development

# ----- Company Details (used in PDFs, emails, and frontend) -----
COMPANY_NAME=T&S Services
COMPANY_ADDRESS=123 Main St, Suite 100, London, UK
COMPANY_PHONE=+44 20 1234 5678
COMPANY_EMAIL=info@tsservices.com
COMPANY_WEBSITE=www.tsservices.com
COMPANY_ABN=

# ----- Frontend Company Details (Vite — must start with VITE_) -----
VITE_COMPANY_NAME=T&S Services
VITE_COMPANY_ADDRESS=123 Main St, Suite 100, London, UK
VITE_COMPANY_PHONE=+44 20 1234 5678
VITE_COMPANY_EMAIL=info@tsservices.com
VITE_COMPANY_WEBSITE=www.tsservices.com
VITE_COMPANY_ABN=
