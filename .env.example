# ============================================================
# T&S CRM — Environment Variables Template
#
#   cp .env.example .env      (or run ./scripts/setup.sh)
#
# NEVER commit .env. This template holds placeholders only —
# real credentials go through a password manager, not a file
# and not chat.
#
# Legend:  [required] must be set or the service will not start
#          [optional] has a working default, or the feature is
#                     simply disabled when unset
# ============================================================


# ============================================================
# 1. SHARED INFRASTRUCTURE
# ============================================================

# ----- PostgreSQL -----
# One instance, six schemas (crm, jobs, scheduling, finance,
# analytics, inventory). Do NOT add a second database — add a
# schema. Postgres lives in Supabase (cloud), NOT docker-compose.
POSTGRES_HOST=localhost                      # [required]
POSTGRES_PORT=5432                           # [required]
POSTGRES_DB=tscrm                            # [required]
POSTGRES_USER=postgres                       # [required]
POSTGRES_PASSWORD=changeme                   # [required] secret

# ----- Redis -----
# BullMQ queues, Socket.IO adapter, scheduling pub/sub, caching.
# Prefer REDIS_URL; HOST/PORT are the older split form.
REDIS_URL=redis://localhost:6379             # [required]
REDIS_HOST=localhost                         # [optional]
REDIS_PORT=6379                              # [optional]
REDIS_PASSWORD=                              # [optional] secret, prod only

# ----- MongoDB (comms-service only) -----
MONGODB_URI=mongodb://localhost:27017/tscrm_comms   # [required for comms]

NODE_ENV=development                         # [required]
APP_NAME=T&S CRM                             # [optional]


# ============================================================
# 2. AUTH
# ============================================================
# Local dev: BYPASS_AUTH=true skips Auth0 and uses local HS256 JWT.
# Set false ONLY with Auth0 configured. Never true in production.
BYPASS_AUTH=true                             # [required]
JWT_SECRET=change-this-to-a-long-random-string   # [required] secret

# Auth0 — only needed when BYPASS_AUTH=false
AUTH0_DOMAIN=                                # [optional]
AUTH0_AUDIENCE=                              # [optional]

# Service-to-service auth
INTERNAL_API_KEY=change-me                   # [optional] secret
SERVICE_JWT=                                 # [optional] secret


# ============================================================
# 3. PER-SERVICE PORTS AND DATABASE URLS
# ============================================================
# Each NestJS service takes a pooled URL (PgBouncer, port 6543)
# and a DIRECT url (session mode, port 5432) that Prisma needs
# for `migrate` and `studio`.

# ----- crm-service (3001) -----
CRM_PORT=3001
CRM_DATABASE_URL=postgresql://user:pass@host:6543/db?schema=crm&pgbouncer=true
CRM_DIRECT_DATABASE_URL=postgresql://user:pass@host:5432/db?schema=crm

# ----- job-service (3002) -----
JOBS_PORT=3002
JOBS_DATABASE_URL=postgresql://user:pass@host:6543/db?schema=jobs&pgbouncer=true
JOBS_DIRECT_DATABASE_URL=postgresql://user:pass@host:5432/db?schema=jobs

# ----- scheduling-service (3003, Go) -----
SCHEDULING_PORT=3003
SCHEDULING_DATABASE_URL=postgresql://user:pass@host:5432/db?schema=scheduling
# The Go service reads the generic DATABASE_URL from its own
# apps/scheduling-service/.env, not SCHEDULING_DATABASE_URL.
DATABASE_URL=postgresql://user:pass@host:5432/db?schema=scheduling
GIN_MODE=debug                               # [optional] "release" in prod
PG_POOL_MAX_CONNS=20                         # [optional]
PG_POOL_MIN_CONNS=2                          # [optional]
WS_MAX_CONNS_PER_COMPANY=200                 # [optional] per-tenant WS cap
OSRM_BASE_URL=                               # [optional] road-distance routing

# ----- finance-service (3004) -----
# NOTE: this service uses the GENERIC names, unlike its siblings.
FINANCE_PORT=3004
FINANCE_DATABASE_URL=postgresql://user:pass@host:6543/db?schema=finance&pgbouncer=true
DIRECT_URL=postgresql://user:pass@host:5432/db?schema=finance

# ----- comms-service (3005) -----
COMMS_PORT=3005
COMMS_DATABASE_URL=postgresql://user:pass@host:6543/db?schema=comms&pgbouncer=true
COMMS_DIRECT_DATABASE_URL=postgresql://user:pass@host:5432/db?schema=comms
# Marketing module has its own Prisma client on the same instance
MARKETING_DATABASE_URL=postgresql://user:pass@host:6543/db?schema=marketing&pgbouncer=true
MARKETING_DIRECT_DATABASE_URL=postgresql://user:pass@host:5432/db?schema=marketing

# ----- analytics-service (3006) -----
ANALYTICS_PORT=3006
ANALYTICS_DATABASE_URL=postgresql://user:pass@host:6543/db?schema=analytics&pgbouncer=true
ANALYTICS_DIRECT_DATABASE_URL=postgresql://user:pass@host:5432/db?schema=analytics

# ----- inventory-service (3007) -----
INVENTORY_PORT=3007
INVENTORY_DATABASE_URL=postgresql://user:pass@host:6543/db?schema=inventory&pgbouncer=true
INVENTORY_DIRECT_DATABASE_URL=postgresql://user:pass@host:5432/db?schema=inventory

# ----- chat / AI assistant (3008) -----
CHAT_PORT=3008
CHAT_HISTORY_TURNS=10                        # [optional]

# ----- churn-service (8000, Python, Docker) -----
CHURN_SERVICE_URL=http://localhost:8000


# ============================================================
# 4. INTERNAL SERVICE URLS
# ============================================================
# How services find each other. Localhost in dev; Cloud Run URLs
# in prod. When updating the prod nginx-gateway ALWAYS use
# `gcloud run deploy --update-env-vars` — `--set-env-vars`
# REPLACES the whole set and silently 404s every route.
API_GATEWAY_URL=http://localhost:80
CRM_SERVICE_URL=http://localhost:3001
JOBS_SERVICE_URL=http://localhost:3002
SCHEDULING_SERVICE_URL=http://localhost:3003
FINANCE_SERVICE_URL=http://localhost:3004
COMMS_SERVICE_URL=http://localhost:3005
ANALYTICS_SERVICE_URL=http://localhost:3006
INVENTORY_SERVICE_URL=http://localhost:3007
REVENUE_AGENT_URL=http://127.0.0.1:8765      # [optional] Python ML tier

# Public-facing URLs used in emails, PDFs and redirect links
FRONTEND_URL=http://localhost:5173
CUSTOMER_PORTAL_URL=http://localhost:5174
MARKETING_CLICK_BASE_URL=http://localhost:5174   # [optional] click tracking


# ============================================================
# 5. OBJECT STORAGE (MinIO locally, S3 in prod)
# ============================================================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tscrm
S3_BUCKET_AVATARS=tscrm-avatars               # [optional]
S3_ACCESS_KEY=minioadmin                      # secret
S3_SECRET_KEY=minioadmin                      # secret
S3_FORCE_PATH_STYLE=true                      # [optional] true for MinIO
S3_AUTO_CREATE_BUCKET=true                    # [optional] dev convenience
S3_PUBLIC_BASE_URL=                           # [optional] CDN base

# AWS-native names, used by some newer upload paths
AWS_REGION=                                   # [optional]
AWS_S3_BUCKET=                                # [optional]
AWS_ACCESS_KEY_ID=                            # [optional] secret
AWS_SECRET_ACCESS_KEY=                        # [optional] secret


# ============================================================
# 6. MESSAGING — EMAIL, SMS, PUSH
# ============================================================

# ----- Email -----
# EMAIL_PROVIDER picks the transport: "sendgrid" or "smtp".
EMAIL_PROVIDER=smtp                           # [optional]

SENDGRID_API_KEY=                             # secret
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SENDGRID_WEBHOOK_SIGNING_SECRET=              # secret

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=                                    # secret
SMTP_FROM=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# ----- SMS (Twilio) -----
TWILIO_ACCOUNT_SID=                           # secret
TWILIO_AUTH_TOKEN=                            # secret
TWILIO_PHONE_NUMBER=
TWILIO_FROM_PHONE=
TWILIO_WEBHOOK_SECRET=                        # secret

# ----- Push: mobile (FCM) -----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=                         # secret, keep the \n escapes

# ----- Push: web (VAPID) -----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                            # secret
VAPID_SUBJECT=mailto:you@example.com


# ============================================================
# 7. PAYMENTS (Stripe)
# ============================================================
# Not configured in dev. PayInvoiceModal degrades gracefully.
STRIPE_SECRET_KEY=                            # secret
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=                        # secret


# ============================================================
# 8. AI / ML
# ============================================================
# Gemini powers crm-service agents (upsell, retention, revenue,
# followup) and analytics recommendations. Unset = rule-only output.
GEMINI_API_KEY=                               # secret
GEMINI_MODEL_UPSELL=gemini-2.5-flash          # [optional]
GEMINI_MODEL_RETENTION=gemini-2.5-flash       # [optional]
GEMINI_MODEL_REVENUE=gemini-2.5-flash         # [optional]
GEMINI_MODEL_FOLLOWUP=gemini-2.5-flash        # [optional]
GEMINI_MODEL_INSIGHTS=gemini-2.5-flash        # [optional]

OPENAI_API_KEY=                               # secret
OPENAI_MODEL_HELP=                            # [optional]
OPENAI_MODEL_DATA=                            # [optional]
OPENAI_MODEL_EQUIPMENT_SCAN=                  # [optional]

# Agent behaviour
UPSELL_AGENT_ENABLED=false                    # [optional]
UPSELL_BATCH_LIMIT=50                         # [optional]
WINBACK_OFFER_TEXT=                           # [optional]


# ============================================================
# 9. THIRD-PARTY INTEGRATIONS (all optional)
# ============================================================
# Each block is inert unless filled in.

# QuickBooks
QB_CLIENT_ID=
QB_CLIENT_SECRET=                             # secret
QB_REDIRECT_URI=
QB_ENVIRONMENT=sandbox

# Google Nest
NEST_PROJECT_ID=
NEST_CLIENT_ID=
NEST_CLIENT_SECRET=                           # secret
NEST_REDIRECT_URI=

# Resideo / Honeywell
RESIDEO_CLIENT_ID=
RESIDEO_CLIENT_SECRET=                        # secret
RESIDEO_REDIRECT_URI=

# Facebook lead ingestion
FACEBOOK_APP_SECRET=                          # secret
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=                   # secret
FACEBOOK_VERIFY_TOKEN=                        # secret
FACEBOOK_COMPANY_ID=

# IoT payload encryption
IOT_ENCRYPTION_KEY=                           # secret

# Marketing link signing
MARKETING_TOKEN_SECRET=                       # secret


# ============================================================
# 10. TUNING (safe defaults — change in prod, not in code)
# ============================================================
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT=20
PRISMA_TRANSACTION_MAX_WAIT_MS=5000
PRISMA_TRANSACTION_TIMEOUT_MS=10000
CRM_DB_CONNECT_RETRIES=5
CRM_DB_CONNECT_DELAY_MS=2000
PDF_MAX_CONCURRENT=4                          # Chromium singleton concurrency
CHROMIUM_PATH=                                # [optional] Puppeteer override


# ============================================================
# 11. COMPANY DETAILS (PDFs, emails)
# ============================================================
COMPANY_NAME=T&S Brothers
COMPANY_ABN=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_WEBSITE=
COMPANY_TIMEZONE=Asia/Colombo
SEED_COMPANY_ID=co-demo-001                   # [optional] demo tenant


# ============================================================
# 12. FRONTENDS (Vite — must be prefixed VITE_)
# ============================================================
# These go in apps/admin-dashboard/.env and
# apps/customer-portal/.env, not only here.
VITE_API_BASE_URL=/api
VITE_WS_URL=
VITE_DISPATCH_WS_BASE=                        # [optional] non-standard setups
VITE_COMPANY_ID=co-demo-001                   # customer-portal demo tenant
VITE_COMPANY_NAME=
VITE_COMPANY_ABN=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_PHONE=
VITE_COMPANY_EMAIL=
VITE_COMPANY_WEBSITE=


# ============================================================
# 13. MOBILE APPS (Expo — must be prefixed EXPO_PUBLIC_)
# ============================================================
# For apps/technician-app/.env and apps/customer-app/.env.
# EXPO_PUBLIC_* is embedded in the built binary — never put a
# secret here.
EXPO_PUBLIC_API_BASE_URL=http://localhost:80/api
EXPO_PUBLIC_WS_BASE_URL=http://localhost:80
EXPO_PUBLIC_COMPANY_ID=co-demo-001
EXPO_ACCESS_TOKEN=                            # [optional] secret, EAS CI only
